DATABASE_URL=postgresql://hms:hms@localhost:5433/hms
TEST_DATABASE_URL=postgresql://hms:hms@localhost:5434/hms_test
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional tuning (defaults shown)
# Max login attempts per minute per IP
LOGIN_RATE_LIMIT=20
# bcrypt cost factor (tests use 4); omit for the default
# BCRYPT_COST=12
# Seed volume: small | large (case-insensitive). Unset means large.
# SEED_SCALE=large
# Seeding is refused when NODE_ENV=production unless this is 1 (it overwrites settings and demo users)
# SEED_ALLOW_PRODUCTION=1
