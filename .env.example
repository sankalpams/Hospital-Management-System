# ---------------------------------------------------------------
# HMS environment configuration — EXAMPLE ONLY, no real secrets.
# Copy to .env (git-ignored) and fill in. On Windows production set
# these as system environment variables or in the WinSW service XML.
# ---------------------------------------------------------------

# --- Database ---------------------------------------------------
# Dev (Docker, see deploy/docker): jdbc:mysql://127.0.0.1:3307/hms
# Prod (native MySQL service):     jdbc:mysql://127.0.0.1:3306/hms
HMS_DB_URL=jdbc:mysql://127.0.0.1:3307/hms?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
HMS_DB_USERNAME=hms_app
HMS_DB_PASSWORD=change-me-strong-password
# Only used by docker-compose.dev.yml to initialise the dev container
HMS_DB_ROOT_PASSWORD=change-me-root-password

# --- First Super Admin (created once, only if no users exist) ----
# The account is forced to change this password on first login.
HMS_BOOTSTRAP_ADMIN_USERNAME=superadmin
HMS_BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-10-chars-1
HMS_BOOTSTRAP_ADMIN_FULLNAME=System Administrator
# Idle session timeout (Spring duration format)
HMS_SESSION_IDLE=30m

# --- Application ------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
HMS_SERVER_PORT=8080
# Comma-separated origins allowed for CORS (dev only; prod is same-origin via Apache)
HMS_CORS_ORIGINS=http://localhost:5173
# Folder for uploaded patient documents (must be outside the Apache document root)
HMS_UPLOAD_DIR=./data/uploads
# true in production (cookie only sent over HTTPS)
HMS_COOKIE_SECURE=false
