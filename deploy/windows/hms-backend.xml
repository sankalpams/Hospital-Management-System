<!--
  WinSW service definition for the HMS Spring Boot backend: a TEMPLATE.
  install-hms.ps1 fills in the Java path, folders and secrets (typed at prompts), restricts the
  installed copy to Administrators + SYSTEM, and removes the one-time admin password after first start.
  Never put real passwords in this repository copy.
-->
<service>
  <id>hms-backend</id>
  <name>HMS Backend (Spring Boot)</name>
  <description>Hospital Management System REST API</description>
  <executable>C:\Program Files\Eclipse Adoptium\jdk-17.0.20.101-hotspot\bin\java.exe</executable>
  <arguments>-Xms256m -Xmx1024m -Dfile.encoding=UTF-8 -jar "C:\hms\backend\hms-backend.jar"</arguments>
  <workingdirectory>C:\hms\backend</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>MySQL80</depend>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

  <env name="SPRING_PROFILES_ACTIVE" value="prod"/>
  <env name="HMS_DB_URL" value="jdbc:mysql://127.0.0.1:3306/hms?serverTimezone=UTC&amp;useSSL=false&amp;allowPublicKeyRetrieval=true"/>
  <env name="HMS_DB_USERNAME" value="hms_app"/>
  <env name="HMS_DB_PASSWORD" value="SET-ME"/>
  <env name="HMS_BOOTSTRAP_ADMIN_USERNAME" value="superadmin"/>
  <env name="HMS_BOOTSTRAP_ADMIN_PASSWORD" value="SET-ME-then-remove-after-first-start"/>
  <env name="HMS_UPLOAD_DIR" value="C:\hms\data\uploads"/>
  <env name="HMS_LOG_DIR" value="C:\hms\backend\logs"/>
  <env name="HMS_COOKIE_SECURE" value="false"/>
</service>
