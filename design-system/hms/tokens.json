{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "HMS design tokens. Source of truth. Regenerate CSS with: npm run tokens (frontend). Palette 100-500 are the brand colours exactly as supplied; 600-700 are darker shades of the same hue added so white text meets WCAG AA.",
  "primitive": {
    "color": {
      "brand": {
        "50":  { "$value": "#EEF5FA", "$type": "color" },
        "100": { "$value": "#B7D3E3", "$type": "color" },
        "200": { "$value": "#A4C8E1", "$type": "color" },
        "300": { "$value": "#8FB8D8", "$type": "color" },
        "400": { "$value": "#6FA3D8", "$type": "color" },
        "500": { "$value": "#4A8BBE", "$type": "color" },
        "600": { "$value": "#346F9E", "$type": "color" },
        "700": { "$value": "#24537A", "$type": "color" },
        "800": { "$value": "#1A3C59", "$type": "color" }
      },
      "slate": {
        "50":  { "$value": "#F8FAFC", "$type": "color" },
        "100": { "$value": "#F1F5F9", "$type": "color" },
        "200": { "$value": "#E2E8F0", "$type": "color" },
        "300": { "$value": "#CBD5E1", "$type": "color" },
        "400": { "$value": "#94A3B8", "$type": "color" },
        "500": { "$value": "#5B6B82", "$type": "color" },
        "600": { "$value": "#475569", "$type": "color" },
        "700": { "$value": "#334155", "$type": "color" },
        "800": { "$value": "#1E293B", "$type": "color" },
        "900": { "$value": "#0F172A", "$type": "color" }
      },
      "green":  { "50": { "$value": "#ECFDF3", "$type": "color" }, "600": { "$value": "#16A34A", "$type": "color" }, "700": { "$value": "#15803D", "$type": "color" } },
      "amber":  { "50": { "$value": "#FFF8EB", "$type": "color" }, "500": { "$value": "#F59E0B", "$type": "color" }, "700": { "$value": "#B45309", "$type": "color" } },
      "red":    { "50": { "$value": "#FEF2F2", "$type": "color" }, "600": { "$value": "#DC2626", "$type": "color" }, "700": { "$value": "#B91C1C", "$type": "color" } },
      "violet": { "50": { "$value": "#F5F3FF", "$type": "color" }, "700": { "$value": "#6D28D9", "$type": "color" } },
      "white":  { "$value": "#FFFFFF", "$type": "color" }
    },
    "font": {
      "heading": { "$value": "'Poppins', 'Segoe UI', system-ui, sans-serif", "$type": "fontFamily" },
      "body":    { "$value": "'Noto Sans', 'Segoe UI', system-ui, sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "'JetBrains Mono', Consolas, monospace", "$type": "fontFamily" }
    },
    "radius": {
      "sm": { "$value": "0.375rem", "$type": "dimension" },
      "md": { "$value": "0.5rem",   "$type": "dimension" },
      "lg": { "$value": "0.75rem",  "$type": "dimension" },
      "xl": { "$value": "1rem",     "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "xs": { "$value": "0 1px 2px 0 rgb(26 60 89 / 0.05)", "$type": "shadow" },
      "sm": { "$value": "0 1px 3px 0 rgb(26 60 89 / 0.08), 0 1px 2px -1px rgb(26 60 89 / 0.06)", "$type": "shadow" },
      "md": { "$value": "0 4px 12px -2px rgb(26 60 89 / 0.10), 0 2px 4px -2px rgb(26 60 89 / 0.06)", "$type": "shadow" },
      "lg": { "$value": "0 12px 32px -8px rgb(26 60 89 / 0.18)", "$type": "shadow" }
    },
    "duration": {
      "fast":   { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" }
    }
  },
  "semantic": {
    "color": {
      "background":         { "$value": "{primitive.color.brand.50}",  "$type": "color" },
      "surface":            { "$value": "{primitive.color.white}",      "$type": "color" },
      "surface-muted":      { "$value": "{primitive.color.slate.50}",   "$type": "color" },
      "foreground":         { "$value": "{primitive.color.slate.900}",  "$type": "color" },
      "foreground-muted":   { "$value": "{primitive.color.slate.600}",  "$type": "color" },
      "foreground-subtle":  { "$value": "{primitive.color.slate.500}",  "$type": "color" },
      "border":             { "$value": "{primitive.color.slate.200}",  "$type": "color" },
      "border-strong":      { "$value": "{primitive.color.brand.200}",  "$type": "color" },
      "primary":            { "$value": "{primitive.color.brand.600}",  "$type": "color" },
      "primary-hover":      { "$value": "{primitive.color.brand.700}",  "$type": "color" },
      "primary-foreground": { "$value": "{primitive.color.white}",      "$type": "color" },
      "primary-soft":       { "$value": "{primitive.color.brand.100}",  "$type": "color" },
      "primary-soft-foreground": { "$value": "{primitive.color.brand.800}", "$type": "color" },
      "accent":             { "$value": "{primitive.color.brand.500}",  "$type": "color" },
      "ring":               { "$value": "{primitive.color.brand.500}",  "$type": "color" },
      "sidebar":            { "$value": "{primitive.color.brand.800}",  "$type": "color" },
      "sidebar-foreground": { "$value": "{primitive.color.brand.100}",  "$type": "color" },
      "sidebar-active":     { "$value": "{primitive.color.brand.600}",  "$type": "color" },
      "success":            { "$value": "{primitive.color.green.700}",  "$type": "color" },
      "success-soft":       { "$value": "{primitive.color.green.50}",   "$type": "color" },
      "warning":            { "$value": "{primitive.color.amber.700}",  "$type": "color" },
      "warning-soft":       { "$value": "{primitive.color.amber.50}",   "$type": "color" },
      "danger":             { "$value": "{primitive.color.red.700}",    "$type": "color" },
      "danger-soft":        { "$value": "{primitive.color.red.50}",     "$type": "color" },
      "info":               { "$value": "{primitive.color.brand.700}",  "$type": "color" },
      "info-soft":          { "$value": "{primitive.color.brand.50}",   "$type": "color" },
      "neutral":            { "$value": "{primitive.color.slate.700}",  "$type": "color" },
      "neutral-soft":       { "$value": "{primitive.color.slate.100}",  "$type": "color" },
      "special":            { "$value": "{primitive.color.violet.700}", "$type": "color" },
      "special-soft":       { "$value": "{primitive.color.violet.50}",  "$type": "color" },
      "chart-1":            { "$value": "#2F6FB8", "$type": "color", "$description": "Series 1 (validated with chart-2 for CVD and contrast, dataviz validator)" },
      "chart-2":            { "$value": "#EB6834", "$type": "color", "$description": "Series 2" },
      "chart-3":            { "$value": "{primitive.color.brand.200}",  "$type": "color" },
      "chart-4":            { "$value": "{primitive.color.amber.500}",  "$type": "color" },
      "chart-5":            { "$value": "{primitive.color.green.600}",  "$type": "color" },
      "chart-6":            { "$value": "{primitive.color.slate.400}",  "$type": "color" }
    },
    "font": {
      "heading": { "$value": "{primitive.font.heading}", "$type": "fontFamily" },
      "body":    { "$value": "{primitive.font.body}",    "$type": "fontFamily" },
      "mono":    { "$value": "{primitive.font.mono}",    "$type": "fontFamily" }
    }
  },
  "component": {
    "button": {
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "height": { "$value": "2.5rem", "$type": "dimension" }
    },
    "input": {
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "height": { "$value": "2.5rem", "$type": "dimension" }
    },
    "card": {
      "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "shadow": { "$value": "{primitive.shadow.sm}", "$type": "shadow" }
    },
    "layout": {
      "sidebar-width": { "$value": "16rem", "$type": "dimension" },
      "topbar-height": { "$value": "4rem",  "$type": "dimension" }
    }
  }
}
